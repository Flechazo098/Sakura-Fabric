{
  "schemaVersion": 1,
  "id": "sakura",
  "version": "${version}",
  "name": "Sakura-Fabric",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/sakura-fabric/icon.png",
  "environment": "*",
