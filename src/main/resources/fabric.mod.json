{
  "schemaVersion": 1,
  "id": "sakura",
  "version": "${version}",
  "name": "Sakura-Orihime",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.flechazo.sakura.client.handler.SakuraClientEventHandler"
    ],
    "main": [
      "com.flechazo.sakura.SakuraFabric"
    ],
    "cardinal-components": [
      "com.flechazo.sakura.capability.SakuraComponents"
    ],
    "datagen": [
      "com.flechazo.sakura.SakuraFabricDataGen"
    ],
    "jei_mod_plugin": [
      "com.flechazo.sakura.compat.jei.JEIPlugin"
    ]
  },
  "mixins": [
    "sakura-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "cardinal-components": [
      "sakura:item_handler",
      "sakura:fluid_handler"
    ]
  },
  "accessWidener" : "sakura.accesswidener"
}
